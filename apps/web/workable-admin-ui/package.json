{
  "name": "workable-admin-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --use-system-ca --max-http-header-size=32768 ./node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "node --max-http-header-size=32768 ./node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "test": "node --import ./test/tsx-register.mjs --test --test-isolation=none \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "test:coverage": "node --import ./test/tsx-register.mjs --test --test-isolation=none --experimental-test-coverage \"--test-coverage-include=src/**/*.ts\" \"--test-coverage-include=src/**/*.tsx\" \"--test-coverage-exclude=src/**/*.test.ts\" \"--test-coverage-exclude=src/**/*.test.tsx\" \"--test-coverage-exclude=src/test/**\" \"src/**/*.test.ts\" \"src/**/*.test.tsx\""
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.0",
    "@tanstack/react-virtual": "^3.13.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.14.0",
    "next": "16.3.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^29.1.1",
    "shadcn": "^4.7.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.25",
    "qs": "6.15.2"
  }
}
