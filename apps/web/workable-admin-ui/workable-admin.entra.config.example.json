{
  "authProvider": "entra",
  "apiUrl": "<url here>",
  "allowedApiUrls": [
    "<other urls here, if any>"
  ],
  "entraId": {
    "tenantId": "<tenant-id-or-domain>",
    "clientId": "<application-client-id>",
    "redirectUri": "http://localhost:3000/api/auth/entra/callback",
    "targetApis": [
      {
        "apiUrl": "<url here>",
        "scope": "api://<target-app-client-id>/workable.access"
      }
    ],
    "allowedEmails": [],
    "allowedEmailDomains": [
      "<company-domain.example>"
    ]
  },
  "sessionSecret": "replace-with-a-long-random-session-signing-secret",
  "sessionMaxAgeSeconds": 28800
}
