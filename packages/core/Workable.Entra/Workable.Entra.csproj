<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Microsoft Entra ID bearer-token integration for Workable ASP.NET Core adapter surfaces, including JWT validation and Workable authorization claim mapping.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Workable.AspNetCore\Workable.AspNetCore.csproj" />
    <ProjectReference Include="..\Workable\Workable.csproj" />
  </ItemGroup>

</Project>
